name: proxy

services:
  caddy:
    image: {{ proxy_caddy_image }}
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    networks:
{% if proxy_caddy_ipv4_address | default('') %}
      backend:
        ipv4_address: "{{ proxy_caddy_ipv4_address }}"
{% else %}
      - backend
{% endif %}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - {{ stack_root }}/proxy/Caddyfile:/etc/caddy/Caddyfile:Z
      - {{ storage_root }}/caddy/data:/data:Z
      - {{ storage_root }}/caddy/config:/config:Z
      - {{ storage_root }}/wordpress/html:/apps/wordpress:ro,z

networks:
  backend:
    name: homelab_backend
    external: true
