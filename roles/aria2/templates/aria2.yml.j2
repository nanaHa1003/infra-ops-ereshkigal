name: aria2

services:
  aria2:
    image: {{ aria2_image }}
    container_name: aria2
    restart: unless-stopped
    # Aria2B manages peer blocklists with ipset in the container network namespace.
    cap_add:
      - NET_ADMIN
    ports:
      - "{{ aria2_rpc_port }}:{{ aria2_rpc_port }}"
      - "{{ aria2_bt_port }}:{{ aria2_bt_port }}"
      - "{{ aria2_bt_port }}:{{ aria2_bt_port }}/udp"
    environment:
      - PUID=1000
      - PGID=1000
      - UMASK_SET=022
      - SECRET={{ vault_secrets.aria2.rpc_secret }}
      - RPC_PORT={{ aria2_rpc_port }}
      - LISTEN_PORT={{ aria2_bt_port }}
      - TZ={{ timezone }}
    volumes:
      # Aria2B may need the host's kernel module metadata for ipset support.
      - /lib/modules:/lib/modules:ro
      - {{ storage_root }}/aria2/config:/config:Z
      - {{ storage_root }}/aria2/downloads:/downloads:Z
