name: auth

services:
  postgresql:
    image: {{ auth_postgres_image }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d authentik -U authentik"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    networks:
      - backend
    volumes:
      - {{ storage_root }}/authentik/postgresql:/var/lib/postgresql/data:Z
    environment:
      POSTGRES_PASSWORD: {{ vault_secrets.authentik.pgpass }}
      POSTGRES_USER: authentik
      POSTGRES_DB: authentik

  redis:
    image: {{ auth_redis_image }}
    command: --save 60 1 --loglevel warning
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 3s
    networks:
      - backend
    volumes:
      - {{ storage_root }}/authentik/redis:/data:Z

  authentik-server:
    image: {{ auth_authentik_image }}
    restart: unless-stopped
    command: server
    networks:
      - backend
    environment: &authentik-environment
      AUTHENTIK_SECRET_KEY: {{ vault_secrets.authentik.secret_key }}
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: {{ vault_secrets.authentik.pgpass }}
      AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS: "{{ auth_trusted_proxy_cidrs }}"

      # SMTP Host Emails are sent to
      AUTHENTIK_EMAIL__FROM: "{{ auth_email_from }}"
      AUTHENTIK_EMAIL__HOST: "{{ auth_smtp_host }}"
      AUTHENTIK_EMAIL__PORT: "{{ auth_smtp_port }}"

      AUTHENTIK_EMAIL__USERNAME: {{ vault_secrets.authentik.email_username }}
      AUTHENTIK_EMAIL__PASSWORD: {{ vault_secrets.authentik.email_password }}

      AUTHENTIK_EMAIL__USE_TLS: "{{ auth_smtp_use_tls }}"
      AUTHENTIK_EMAIL__USE_SSL: "{{ auth_smtp_use_ssl }}"

      AUTHENTIK_EMAIL__TIMEOUT: "{{ auth_smtp_timeout }}"
    volumes:
      - {{ storage_root }}/authentik/media:/media:z
      - {{ storage_root }}/authentik/templates:/templates:z
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

  authentik-worker:
    image: {{ auth_authentik_image }}
    restart: unless-stopped
    command: worker
    networks:
      - backend
      - socket_net
    environment: *authentik-environment
    user: root
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:z
      - {{ storage_root }}/authentik/media:/media:z
      - {{ storage_root }}/authentik/templates:/templates:z
    depends_on:
      postgresql:
        condition: service_healthy
      redis:
        condition: service_healthy

networks:
  backend:
    external: true
    name: homelab_backend

  socket_net:
    external: true
    name: socket_net
